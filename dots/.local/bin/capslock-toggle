#!/usr/bin/env bash
sleep 0.05
state=$(hyprctl devices -j 2>/dev/null | jq -r '.keyboards[] | select(.main == true) | .capsLock' 2>/dev/null)
if [ -z "$state" ] || [ "$state" = "null" ]; then
    state=$(hyprctl keyboards -j | jq -r '.[] | select(.main == true) | .capsLock' 2>/dev/null)
fi
quickshell -c ii ipc call keyIndicator showIndicator "capslock" "$state"
