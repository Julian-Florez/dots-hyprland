#!/usr/bin/env bash
exec 3>&1 4>&2
trap 'exec 2>&4 1>&3' 0 1 2 3
exec 1>/tmp/micmute-toggle.log 2>&1
set -x

echo "Date: $(date)"
echo "PATH: $PATH"
echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"
wpctl set-mute @DEFAULT_SOURCE@ toggle
status=$(wpctl get-volume @DEFAULT_SOURCE@)
if echo "$status" | grep -q "MUTED"; then
    state="true"
else
    state="false"
fi
echo "State determined: $state"
quickshell -c ii ipc call keyIndicator showIndicator "micmute" "$state"
