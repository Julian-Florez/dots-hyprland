#!/usr/bin/env bash
exec 3>&1 4>&2
trap 'exec 2>&4 1>&3' 0 1 2 3
exec 1>/tmp/touchpad-toggle.log 2>&1
set -x

echo "Date: $(date)"
device=$(hyprctl devices -j | jq -r '.mice[] | select(.name | contains("touchpad")) | .name' | head -n 1)
if [ -z "$device" ]; then
    echo "No touchpad device found!"
    exit 1
fi
state_file="/tmp/qs_touchpad_state"
if [ -f "$state_file" ] && [ "$(cat "$state_file")" = "false" ]; then
    new_state="true"
else
    new_state="false"
fi
echo "$new_state" > "$state_file"
echo "Setting touchpad $device to $new_state"

hyprctl eval "hl.device({ name = '$device', enabled = $new_state })"
quickshell -c ii ipc call keyIndicator showIndicator "touchpad" "$new_state"
