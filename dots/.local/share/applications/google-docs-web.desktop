[Desktop Entry]
Version=1.0
Type=Application
Name=Documentos
Comment=Create and edit documents online
Exec=/home/julian/.local/bin/office-web-wrapper --type document %f
Keywords=word;google;office;docs
Icon=google-docs
Terminal=false
Categories=Office;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;
StartupNotify=true
StartupWMClass=chrome-docs.google.com__document_-Default
